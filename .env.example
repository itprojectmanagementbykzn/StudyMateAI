# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Google Gemini API key (get one at https://aistudio.google.com/app/apikey).
# Exposed to the browser by Vite — use a key restricted to this app.
VITE_GEMINI_API_KEY=

# Backend API base URL.
VITE_API_URL=https://hackathon-20uq.onrender.com

# Gemini model to use. Defaults to the auto-updating "latest Flash" alias.
# Pin a specific version if you prefer, e.g. VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-flash-latest
