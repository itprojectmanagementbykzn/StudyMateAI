# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Google Gemini API key (get one at https://aistudio.google.com/app/apikey).
# Exposed to the browser by Vite — use a key restricted to this app.
VITE_GEMINI_API_KEY=

# Backend API base URL.
VITE_API_URL=https://hackathon-20uq.onrender.com

# Gemini model to use. Pinned to the latest stable Flash by default;
# set to "gemini-flash-latest" for the auto-updating alias.
VITE_GEMINI_MODEL=gemini-3.5-flash
