# Copy this file to ".env" and fill in your own values. Never commit ".env".

# ---------------------------------------------------------------------------
# Server-side secrets (NOT exposed to the browser)
# Used only by the serverless functions in /api, so they never ship in the
# client bundle. On Vercel, set these in Project Settings -> Environment
# Variables (not in a committed file).
# ---------------------------------------------------------------------------

# Google Gemini API key. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model. Defaults to the auto-updating "latest Flash" alias.
# Pin a version if you prefer, e.g. GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Client-side values (exposed to the browser via Vite — safe, non-secret)
# ---------------------------------------------------------------------------

# Backend API base URL for quizzes / progress / auth.
VITE_API_URL=https://hackathon-20uq.onrender.com

# Optional: override the AI proxy endpoint (defaults to "/api/gemini").
# VITE_GEMINI_PROXY_URL=/api/gemini
