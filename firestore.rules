rules_version = '2';

// StudyMateAI Firestore security rules.
// Each user may read and write ONLY their own progress document at users/{uid}.
// Deploy with: firebase deploy --only firestore:rules  (or paste in the console).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
